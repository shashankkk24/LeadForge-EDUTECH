# LeadForge EDU Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# ============ DATABASE ============
# Using NeonDB (free PostgreSQL tier)
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_hVuBbD1yM7cL@ep-lively-frost-ae2m0s7o-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local PostgreSQL (alternative)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/leadforge

# ============ GEMINI API ============
# Optional - if not provided, uses mock responses
GEMINI_API_KEY=your_gemini_api_key_here

# ============ SMTP / EMAIL ============
# Optional - if not provided, uses email simulation mode
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# NOTE: For Gmail:
# 1. Enable 2-Factor Authentication
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an App Password
# 4. Use that password here (NOT your main password)

# ============ REDDIT API (PRAW) ============
# Optional - if not provided, uses mock scraper
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=LeadForgeEDU/1.0

# NOTE: Create Reddit app at https://www.reddit.com/prefs/apps

# ============ LINKEDIN API ============
# For LinkedIn scraping and lead data enrichment
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password
# Alternatively, use OAuth token if available
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# ============ APIFY API ============
# Apify platform for web scraping and data extraction
APIFY_API_TOKEN=your_apify_api_token
# Example Apify Actor IDs for common scrapers:
# - linkedin-scraper: 61RPP7dywgAH6w8nL
# - google-search-results: jbMR8dEWC5OmBWHJh
# - web-scraper-cheerio: quQnARePidAH9w9fJ
APIFY_ACTOR_ID=your_apify_actor_id  # Select appropriate actor for your needs

# ============ SELENIUM CONFIGURATION ============
# For browser-based scraping (LinkedIn, form automation, JavaScript-heavy sites)
SELENIUM_HEADLESS=true
SELENIUM_BROWSER=chrome  # Options: chrome, firefox, edge
SELENIUM_TIMEOUT=30  # Timeout in seconds
# Path to chromedriver (leave empty for automatic download)
CHROMEDRIVER_PATH=

# ============ WEB SCRAPING TARGETS ============
# Websites and keywords to monitor
SCRAPE_TARGETS=reddit.com,linkedin.com,twitter.com,github.com
SCRAPE_KEYWORDS=edtech,school management,student assessment,e-learning

# ============ APPLICATION ============
DEBUG=true
APP_NAME=LeadForge EDU
APP_VERSION=0.1.0

# CORS - allowed origins for frontend
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============ FEATURE FLAGS ============
# Enable/disable specific scraping sources
ENABLE_REDDIT_SCRAPER=true
ENABLE_LINKEDIN_SCRAPER=true
ENABLE_APIFY_SCRAPER=true
ENABLE_SELENIUM_SCRAPER=true
ENABLE_SMART_ENRICHMENT=true
